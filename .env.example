# Copy this file to .env and fill in your real values.
# Keep .env out of version control.

# Primary AI Brain: Google Gemini
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JARVIS_AI_PROVIDER=gemini

# Optional: Anthropic API fallback
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Telegram Integration (for remote commands & phone live alerts)
# Create a bot with @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local free model fallback (Ollama)
JARVIS_DEV_MODE=false
JARVIS_USE_LOCAL_MODEL=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google / Gmail / Calendar OAuth token
GMAIL_TOKEN_FILE=.secrets/google_token.json
GMAIL_CLIENT_SECRET_FILE=.secrets/google_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=

# GitHub Personal Access Token
GITHUB_TOKEN=
