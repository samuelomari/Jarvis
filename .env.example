# Copy this file to .env and fill in your real values.
# Keep .env out of version control.

# Optional: Paid Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Local free model fallback
JARVIS_DEV_MODE=false
JARVIS_USE_LOCAL_MODEL=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google / Gmail / Calendar OAuth token
GMAIL_TOKEN_FILE=.secrets/google_token.json
GMAIL_CLIENT_SECRET_FILE=.secrets/google_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=

# GitHub PAT
GITHUB_TOKEN=
